<?xml version="1.0" encoding="utf-8" ?>
<extension type="plugin" group="healthchecker" method="upgrade">
    <name>plg_healthchecker_example</name>
    <author>mySites.guru / Phil E. Taylor</author>
    <creationDate>2026-03-11</creationDate>
    <copyright>(C) 2026 mySites.guru / Phil E. Taylor</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>phil@phil-taylor.com</authorEmail>
    <authorUrl>https://mySites.guru</authorUrl>
    <version>3.9.10</version>
    <description>PLG_HEALTHCHECKER_EXAMPLE_XML_DESCRIPTION</description>
    <namespace path="src">MySitesGuru\HealthChecker\Plugin\Example</namespace>
    <files>
        <folder plugin="example">services</folder>
        <folder>src</folder>
        <folder>language</folder>
        <filename>DEVELOPER_GUIDE.md</filename>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/plg_healthchecker_example.ini</language>
        <language tag="en-GB">en-GB/plg_healthchecker_example.sys.ini</language>
        <language tag="es-ES">es-ES/plg_healthchecker_example.ini</language>
        <language tag="es-ES">es-ES/plg_healthchecker_example.sys.ini</language>
    </languages>

    <!-- Developer Guide tab visible in Extensions > Plugins > Edit -->
    <config>
        <fields name="params">
            <fieldset
                name="developer_guide"
                label="PLG_HEALTHCHECKER_EXAMPLE_TAB_GUIDE_LABEL"
            >
                <field
                    name="guide_intro"
                    type="note"
                    label=""
                    description="PLG_HEALTHCHECKER_EXAMPLE_GUIDE_INTRO"
                />

                <field
                    name="guide_events"
                    type="note"
                    label="PLG_HEALTHCHECKER_EXAMPLE_GUIDE_EVENTS_LABEL"
                    description="PLG_HEALTHCHECKER_EXAMPLE_GUIDE_EVENTS_DESC"
                    class="alert alert-info"
                />

                <field
                    name="guide_steps"
                    type="note"
                    label="PLG_HEALTHCHECKER_EXAMPLE_GUIDE_STEPS_LABEL"
                    description="PLG_HEALTHCHECKER_EXAMPLE_GUIDE_STEPS_DESC"
                    class="alert alert-info"
                />

                <field
                    name="guide_categories"
                    type="note"
                    label="PLG_HEALTHCHECKER_EXAMPLE_GUIDE_CATEGORIES_LABEL"
                    description="PLG_HEALTHCHECKER_EXAMPLE_GUIDE_CATEGORIES_DESC"
                    class="alert alert-info"
                />

                <field
                    name="guide_docs"
                    type="note"
                    label="PLG_HEALTHCHECKER_EXAMPLE_GUIDE_DOCS_LABEL"
                    description="PLG_HEALTHCHECKER_EXAMPLE_GUIDE_DOCS_DESC"
                    class="alert alert-success"
                />

            </fieldset>
        </fields>
    </config>

    <updateservers>
        <server
            type="extension"
            priority="1"
            name="Health Checker - Example Plugin"
        >https://www.joomlahealthchecker.com/update/plg_healthchecker_example.xml</server>
    </updateservers>

    <client>0</client>
</extension>
